# ──────────────────────────────────────────────
# DocuIntel AI — Environment Variables Template
# ──────────────────────────────────────────────
# Copy this file to .env before running:
#   cp .env.example .env        (Linux/macOS)
#   copy .env.example .env      (Windows)
#
# Then edit .env with your own values.
# .env is git-ignored and will NOT be committed.
# ──────────────────────────────────────────────

# ── PostgreSQL (used by docker-compose) ──────
POSTGRES_USER=docuintel
POSTGRES_PASSWORD=changeme
POSTGRES_DB=docuintel_db
POSTGRES_PORT=5432

# ── Backend ──────────────────────────────────
PROJECT_NAME=DocuIntel AI
VERSION=0.1.0
DEBUG=True
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
DATABASE_URL=postgresql+psycopg://docuintel:changeme@localhost:5432/docuintel_db
